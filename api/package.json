{
  "name": "@zoa/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/handlers/**/*.ts --bundle --platform=node --target=node20 --outdir=dist --format=cjs --sourcemap",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "offline": "serverless offline",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.787.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/lib-dynamodb": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "jose": "^6.0.10",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^20.17.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.2",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.54.6",
    "serverless-offline": "^13.9.0",
    "typescript": "^5.8.0"
  }
}
