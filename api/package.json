{
  "name": "@zoa/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/handlers/**/*.ts --bundle --platform=node --target=node20 --outdir=dist --format=cjs --sourcemap",
    "deploy": "serverless deploy --stage prod",
    "deploy:dev": "serverless deploy --stage dev",
    "remove": "serverless remove",
    "offline": "serverless offline",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/**/*.test.ts",
    "seed:email-templates": "tsx scripts/seed-email-templates.ts",
    "migrate:user-to-prod": "tsx scripts/migrate-user-to-prod.ts",
    "provision:prod-admins": "tsx scripts/provision-prod-admins.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.787.0",
    "@aws-sdk/client-dynamodb": "^3.787.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/client-sesv2": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "jose": "^6.0.10",
    "nodemailer": "^10.3.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.2",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.54.6",
    "serverless-offline": "^13.9.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0"
  }
}
