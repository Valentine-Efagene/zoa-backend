# Copy to .env for local serverless offline / deploy (never commit .env).

# Swagger UI at http://localhost:4000/docs
SWAGGER_USER=zoa
SWAGGER_PASSWORD=your-swagger-password

APPLICATIONS_TABLE=zoa-applications-dev
DOCUMENTS_BUCKET=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
CORS_ORIGIN=http://localhost:3000
# Live deploy: include https://zoa-theta.vercel.app (see README Live environment)

# Transactional email (Amazon SES). Set EMAIL_ENABLED=true on live Lambda when SES is ready.
EMAIL_ENABLED=false
EMAIL_TRANSPORT=ses
EMAIL_FROM=Z.O.A Filings <filings@mail.zaynababdussalam.com>
EMAIL_REPLY_TO=abdussalamzaynab@gmail.com
NOTIFY_ADMIN_EMAIL=abdussalamzaynab@gmail.com
APP_BASE_URL=https://zoa-theta.vercel.app

# Local UAT with Mailpit (docker-compose.uat.yml):
# EMAIL_ENABLED=true
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025

# Optional local dev auth bypass when Cognito is unset
# DEV_ADMIN=true
